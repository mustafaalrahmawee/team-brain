APP_NAME=TeamBrain
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=teambrain
DB_USERNAME=teambrain
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Reverb (WebSockets). Der Browser verbindet sich über localhost:8080,
# der Server sendet intern an den Container "reverb".
REVERB_APP_ID=teambrain
REVERB_APP_KEY=teambrain-key
REVERB_APP_SECRET=teambrain-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Sanctum-Token-Ablauf in Minuten
SANCTUM_EXPIRATION=480

# KI-Dienste (nur hier im Backend, nie im Frontend)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# Einfache Fragen und Chat: Haiku mit wenig Effort
ANTHROPIC_MODEL_DEFAULT=claude-haiku-5-5
ANTHROPIC_EFFORT_DEFAULT=low
# Mehrstufige Suche (Agent, UC-09): Sonnet mit hohem Effort
ANTHROPIC_MODEL_AGENT=claude-sonnet-5-5
ANTHROPIC_EFFORT_AGENT=high

# Eval-Richter: ein anderes Modell als der Agent bewertet die Antworten (GLM über z.ai, Anthropic-kompatibel)
TEST_ANTHROPIC_API_KEY=
EVAL_JUDGE_BASE_URL=https://api.z.ai/api/anthropic
EVAL_JUDGE_MODEL=glm-5.3
EVAL_JUDGE_EFFORT=high
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3.5
